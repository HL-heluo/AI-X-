# ─────────────────────────────────────────────────────────────
# 环境变量样例。**复制成 `.env` 再填**：
#
#     cp .env.example .env
#
# `.env` 已在 .gitignore 里，**永远不要提交它**。
#
# 【为什么这个文件里没有任何真密钥】
# 因为 `.env.example` 是**要进 git** 的（它的价值就在于新同学能照着配）。
# 里面出现过的每一个假密钥，都会在某天被人原样复制到生产。
# 所以这里只写「要填什么」，不写「可以填什么」。
# ─────────────────────────────────────────────────────────────

# ── 运行环境 ────────────────────────────────────────────────
APP_ENV=dev
# dev / prod。prod 下错误响应不带堆栈。

TEST_MODE=0
# 【硬门禁】1 才会挂载 `/__test/*`（能凭空发积分、能清库）。
# 只在跑收口验收自动化时开，**绝不要用它对外提供服务**。

# ── 安全 ────────────────────────────────────────────────────
JWT_SECRET=
# 【必填，没有默认值】缺了就启动失败 —— 这是故意的，见 app/config.py 顶部。
# 生成一个：
#   python -c "from app.config import generate_dev_secret as g; print(g())"
#
# ⚠️ 开发与生产必须用**不同**的密钥。共用的话，本地签发的 token
# 在线上直接有效。

JWT_EXPIRE_MINUTES=10080
# 7 天。§6.1 无 refresh token，过期即 401 → 前端登出。

BCRYPT_ROUNDS=12
# 密码哈希强度。测试里会调到 4，否则每条要注册的测试都多付 250ms。

# ── AI provider ─────────────────────────────────────────────
PROVIDER=fake
# **图片那一档**（文生图）。
# fake   = 假 provider，离线、免费、瞬间完成。**默认**。
# jimeng = 真即梦，按秒计费，一条视频要跑十分钟。
# minimax **不行** —— MiniMax 在这条链路上只接了视频，填了启动就失败
# （见 app/config.py）。文生图要换家得先接它的图片接口。
#
# 【为什么要显式改这个，而不是自动探测】见 app/config.py 的说明 ——
# 误连生产必须是「有人主动做了一件事」，不能是「碰巧」。

VIDEO_PROVIDER=
# **视频那一档**（图生视频）。留空 = **跟随 `PROVIDER`**（既有行为）。
#
# 【为什么它要能独立设置】因为「图片一家、视频另一家」是真实需求，
# 而它有个具体的来由：即梦那边那个产品的**并发配额是 0**，图生视频
# 一步都没成过（见 HANDOFF §2.6），所以视频换到 MiniMax 上跑。
# 在这种部署里 PROVIDER 仍然写 jimeng —— 文生图那条路是验过的，
# 不该跟着一起动。

# ── MiniMax（只有 VIDEO_PROVIDER=minimax 时才需要）──────────
MINIMAX_API_KEY=
# 密钥来源：MiniMax 开放平台 → 账户管理 → 接口密钥。
# ⚠️⚠️ 铁律同 AK/SK：只待在这里（或部署平台的密钥管理里），
#    绝不写进任何 .py 文件、绝不提交进 git。
#
# 配了 VIDEO_PROVIDER=minimax 却没填它 → **启动就失败**，见 config.py。
#
# ⚠️ H3 / H3-Max **需要先在平台上「按量购买 API」**，否则第一次提交
#    会拿回一个权限/余额类的错误（402 / 1008）。这不是代码能替你
#    处理的事，去控制台开。

# 下面几个都有默认值，一般不用写：
# MINIMAX_API_HOST=api.minimax.cn
MINIMAX_VIDEO_MODEL=MiniMax-H3-Max
# 可用值只有 MiniMax-H3 与 MiniMax-H3-Max。两者能力档位不同：
# H3 支持 4~15 秒；**H3-Max 只支持 5~15 秒**（不支持 4 秒）。
# 换模型时若时长越界，接口会回 400。
MINIMAX_VIDEO_RESOLUTION=768P
# H3-Max 可用 480P / 768P。
# 【为什么它在这里而不是从请求里读】因为**契约里根本没有分辨率字段** ——
# 前端界面上那个「720P」是纯展示，请求体里没有它（见 HANDOFF §5 第 8 条）。
# 所以这是后端替契约定的一档，不是用户选的。

# ── 即梦（PROVIDER=jimeng，或 VIDEO_PROVIDER=jimeng 时才需要）──
JIMENG_AK=
JIMENG_SK=
# ⚠️⚠️ 铁律：AK/SK 只能待在这里（或部署平台的密钥管理里）。
#    · 绝不写进任何 .py 文件
#    · 绝不提交进 git
#    · 开发与生产用**不同**的子账号密钥（工程文档 §4 + 即梦文档 §1）
#
# 图片或视频**任意一路**配成 jimeng 却没填这两个，**启动就会失败** ——
# 见 config.py。两路都配成 MiniMax 的部署用不上它们。

JIMENG_REGION=cn-north-1
JIMENG_SERVICE=cv
JIMENG_HOST=visual.volcengineapi.com

JIMENG_REQ_KEY_IMAGE=
JIMENG_REQ_KEY_VIDEO=
# ⚠️⚠️ **这两个值要在即梦控制台里确认，不是从文档里抄的**（§18-2）。
# 同一个接口靠不同的 `req_key` 提供不同能力，而它决定了「这次调用
# 走哪个模型、花多少钱」。文档里没有一张公开的对照表。
#
# 【各自只要求自己那一路】`JIMENG_REQ_KEY_IMAGE` 在图片那一路是即梦时
# 必填，`JIMENG_REQ_KEY_VIDEO` 在视频那一路是即梦时必填。缺了自己那一路
# 那个 → **启动就失败**。那是故意的：不拦的话，第一次生成会花掉一次
# **真调用**去换回一句「不支持的 req_key」（守卫见 app/config.py）。
#
# 所以 VIDEO_PROVIDER=minimax 的部署**不用填 JIMENG_REQ_KEY_VIDEO** ——
# 视频那一路根本不走即梦。

# ── 对象存储 ────────────────────────────────────────────────
STORAGE=local
# local = 写到 MEDIA_ROOT 并通过 PUBLIC_BASE_URL 暴露（默认，离线可跑）
# oss   = 走 **S3 协议**（B6 接上了）。阿里云 OSS / 腾讯云 COS / MinIO /
#         Cloudflare R2 都通 —— 差别只在下面的端点与寻址风格。
#         选了它，S3_BUCKET / S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY
#         就是必填，缺一个**启动就失败**（见 app/config.py）。

PUBLIC_BASE_URL=http://127.0.0.1:8000
# 拼接产物公网地址用。
# ⚠️ 必须填**外部可达**的地址。填 localhost 的话，App 拿到的 URL
#    指向它自己，图全是裂的 —— 而且四五个环节都不会报错。
# 【B6 起还有第二个用途】真 provider 时，用户上传的参考图要以
# **公网可达的 URL** 交出去（`source_url`）—— 即梦和 MiniMax 都在
# **它们自己的机房里**下载那张图。填 localhost 的话对方拉不到，
# 报的是一句和「地址没配好」毫无关系的错误。

MEDIA_ROOT=media
# STORAGE=local 时的落地目录（B4 起**真的有文件了**：上传的参考图与生成产物）。

# ── S3 / OSS（只有 STORAGE=oss 时才需要）────────────────────
S3_ENDPOINT_URL=
# 例如 https://oss-cn-hangzhou.aliyuncs.com 。留空则用 AWS 本家。

S3_BUCKET=
S3_REGION=cn-hangzhou
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
# ⚠️ 同 JIMENG_AK/SK 的铁律：只从环境变量读，绝不写进 .py、绝不进 git。
# ⚠️ 用一个**只对这个桶有权限**的子账号密钥，别用主账号的 ——
#    桶被写坏时，主账号密钥能掀掉整个云账号。

S3_PUBLIC_BASE_URL=
# 产物的**永久**公网前缀，例如 https://cdn.example.com
# 或 https://my-bucket.oss-cn-hangzhou.aliyuncs.com 。
# 【为什么不从 endpoint + bucket 拼】因为那个拼法只是地址**可能的**
# 形状之一，而对外域名经常是另一个（CNAME / CDN）。拼错的表现是
# 「所有作品点开都是 404」，而生成、扣费、落库全都正常。
# ⚠️ 它拼出来的地址必须**永久**有效 —— 所以桶要公共读，或挂在 CDN 后面
#    （§9.1 的第一种）。换成预签名地址的话，表现是「昨天生成的作品今天
#    全裂了」，而且本地怎么测都是好的（`app/services/storage.py` 里
#    有这条的完整理由）。

S3_FORCE_PATH_STYLE=0
# 1 = 路径风格（{endpoint}/{bucket}/{key}）
# 0 = 虚拟主机风格（{bucket}.{endpoint}/{key}）
#
# 【2026-10-15 实测，真桶（火山引擎 TOS）】
#   0（virtual）→ 通
#   1（path）   → InvalidPathAccess: Forbidden path to access server
# 所以 TOS 用 0。阿里云 OSS / 腾讯 COS / MinIO **文档上一般说**要 1 ——
# 但那几家本项目**没有实测过**，第一次配的时候请用
# `scripts/check_storage.py` 当场验一遍，别照抄这一行。
#
# ⚠️⚠️ 这一行原本是 `1`，而代码里 `0` 的意思原本是「交给 boto3 自己判」。
# 实测证明那个「自己判」等于**路径风格** —— 于是「关掉这个开关」在真桶上
# 什么都没做。现在 `0` 是明确的 virtual。见 `app/services/storage.py`。
#
# ⚠️ 两个方向的报错形状完全不同，而且都不说「是寻址风格的问题」：
#   · 该 virtual 却给了 path → InvalidPathAccess（TOS 实测）
#   · 该 path 却给了 virtual → 一个 **DNS 解析失败**，错误里只有桶名
# 看到哪一种，都先回来查这一行。

# ── 转存与转码（§9.2 / §9.3，B4）────────────────────────────
PROVIDER_SPOOL_ROOT=.provider_spool
# provider 产物的暂存区。
# 【这不是一个「随便放哪」的目录】转存层只允许读它**之内**的 file:// 地址
# —— 不设这条边界的话，一个被污染的 provider_url 就变成一次任意文件读取
# （后端会把那个文件复制进 MEDIA_ROOT 并公开发布出去）。
# 已在 .gitignore 里；测试夹具会把它钉到 tmp_path。

MAX_ARTIFACT_BYTES=209715200
# 单个产物的转存上限（200MB）。§9.3 的成本自保。
# 【为什么和 MAX_IMAGE_BYTES 是两个数】那个管用户上传（§9.4 规定 20MB），
# 这个管 provider 给我们的成品 —— 一段 720P 视频本来就大得多。
# 用一个数的话，要么视频被卡死，要么上传口子开成 200MB。

FFMPEG_TIMEOUT_SEC=30
# 单次 ffmpeg / ffprobe 调用的超时。
# 【为什么必须有】它们处理的是不可信字节（provider 回来的文件）。
# 畸形容器让解码器陷入长循环是已知的一类问题，而没有超时的话，
# 卡住的是 worker 线程 —— 整个平台的队列跟着停。

TRANSFER_MAX_RETRIES=3
# 转存失败的重试上限。耗尽 → 任务 failed + TRANSFER_FAILED + **全额**退回。
TRANSFER_RETRY_BACKOFF_SEC=2
# 两次转存重试之间的最小间隔。
# 【为什么需要它】worker 一轮是 2 秒而重试预算只有 3 次 —— 没有退避的话，
# 一个坏掉的地址会在 6 秒内烧完全部预算然后判死。退避把「3 次重试」
# 摊开成一段真正的时间，让一次抖动有机会被扛过去。

# ── 计价（§7.1）—— 契约值，改它必须前后端一起改 ─────────────
CREDITS_PER_IMAGE=4
CREDITS_PER_SEC_720=4
DURATION_SLACK_SEC=3
# 冻结 = (输入时长 + 请求时长 + 余量) × 每秒单价
# 5 秒 720P： (5 + 3) × 4 = 冻结 32
# 【余量 3 是占位值】真值由 B0.5 的即梦 Spike 实测修正（§18-2）。

SIGNUP_GRANT=50
# §12.1。原为 20，F8 上调（理由见 flutter_application_1/HANDOFF.md §3.1）。
# 低于 32 的话新用户第一次做视频必然撞墙，而 v1 没有充值入口。

# ── 配额（§7.5 / §8.2）─────────────────────────────────────
DAILY_TASK_LIMIT=20
MAX_CONCURRENT_TASKS=1
# 【这两个数字直接等于钱】§8.2：扩容 ¥500/日/并发。
PROVIDER_QPS=1.0
# 即梦的 QPS 上限（对应审计码 50429）。

# ── 输入上限（§11.2）—— 与前端逐字一致 ─────────────────────
MAX_PROMPT_LEN=2000
MAX_IMAGE_BYTES=20971520
# 20MB = 20 * 1024 * 1024

# ── 队列与 worker（§8）─────────────────────────────────────
WORKER_ENABLED=1
# 【B3】是否在本进程里跑后台 worker 线程。
# ⚠️ 即使这里是 1，`TEST_MODE=1` 也**强制不启动** —— 后台 worker
#    每 2 秒读一次 tasks 表，而 `/__test/reset` 会 drop 掉它。
#    那种冲突报出来的是「no such table: tasks」，长得像迁移漏了。
#
# 关掉它的两种正经用途：手工调试时「只跑 API 不跑 worker」、
# 或者想单独起一个 worker 进程（v1 还没做，见 HANDOFF 的缺口表）。

WORKER_POLL_INTERVAL_SEC=2
# worker 多久巡一次「有没有该出队的任务」。

PROVIDER_POLL_INTERVAL_SEC=10
# 多久问一次 provider「好了没」。
# 【为什么它和上面那个不是一个数】巡是巡、问是问：出队要快
# （用户点了生成，2 秒内该交出去），问进度要慢（一条视频本来
# 就要跑十分钟，2 秒问一次等于对即梦做压力测试）。

PROVIDER_MAX_CONCURRENCY=1
# 【出队闸门】整个平台同时能压几个任务给即梦，**全局、按类分开计**。
#
# ⚠️ 它和上面的 MAX_CONCURRENT_TASKS **不是一个东西，别合并**：
#    MAX_CONCURRENT_TASKS 是 §7.5 的**每用户**入口闸（成本自保，
#    防一个人把额度堆满）；这个是 §8.2 的**闸门值**（物理约束 ——
#    即梦默认并发 1–2 且平台共享，与用户数无关，扩容 ¥500/日/并发）。
#    两者默认都是 1，所以看着像同一个数，但它们会朝不同方向漂：
#    内测用户变多时该动的是上面那个，provider 扩容时只动这个。

TASK_TIMEOUT_SEC=3600
# 超过这个时长还没到终态的任务判 `expired` 并**全额退回**。
# 【为什么必须有这条】它是「冻结永远不释放」的唯一兜底。没有它，
# provider 那边卡住一条任务，用户那笔积分就永久锁在冻结里 ——
# 而冻结在界面上是不可见的（用户看到的是 balance − frozen），
# 所以他只会发现「我明明还有钱，为什么生成不了」。
# 这类事故在账面上查不出来：余额没变、没有失败任务、没有异常流水。

PROVIDER_MAX_RETRIES=3
WORKER_RETRY_BACKOFF_SEC=2
WORKER_RETRY_MAX_BACKOFF_SEC=30
# §7.5 的指数退避：第 n 次重试等 `base × 2^(n-1)` 秒，上限见第二个。
# 【为什么退避不是 `time.sleep`】worker 是单线程的 —— sleep 5 秒
# 等于这 5 秒里全平台的任务一条都出不了队。退避的语义是「**这一个**
# 任务晚点再试」，实现方式是把它在队列里的位置推到未来。
#
# 【上限为什么不是可选项】没有它，PROVIDER_MAX_RETRIES 调到 10
# 的时候第 10 次重试要等 8 分钟，而调那个数的人以为自己在做一件小事。

# ── 合规：审核与隐式标识（§10，B5）──────────────────────────
MODERATION_ENABLED=1
# 入口审核（§10.2 第①层）总开关。**默认开。**
# 【为什么默认开】§10.1 把「生成前审核」列成必做项。默认关的话，
# 一个忘了配的部署就是**不审核**的，而它外表上完全正常
# （/health 正常、测试全绿）。要关必须显式写这一行。

MODERATION_EXTRA_KEYWORDS=
# 额外违规词，英文逗号分隔。运营加词走这里，不用改代码。
# ⚠️ **只放 ASCII。** 中文要经过环境变量 / .env 的编码往返，而本机
#    区域编码是 GBK —— 一个中文词在途中被转成 GBK 字节之后就不再等于
#    代码里的那个词，表现是「词明明配了却拦不住」。
#    中文词请写进 app/services/moderation.py 的 DEFAULT_BLOCKLIST。

MARKING_ENABLED=1
# 给 AI 产物写**隐式标识**（§10.1 的文件元数据）。**默认开。**
# 【法律义务】《人工智能生成合成内容标识办法》要求 —— 不是可选项。
# 关掉它的唯一正当理由是「这台环境的元数据写入工具坏了，先让交付继续」。
# ⚠️ 代价是四条：视频标记依赖 ffmpeg；ffmpeg 不在时**视频任务会失败**
#    （合规优先，见 services/transfer.py）。

MARKING_CREATOR=AI Video Platform
# 标识里的「生成工具」名。**必须是 ASCII** —— 它要进 EXIF / XMP / MP4
# 三种容器，而这三者的字符集约定各不相同。

PROVIDER_CALL_AUDIT_ENABLED=1
# `provider_calls` 对账（§11.1）。**默认开。**
# 这张表 B1 就建好了，却一直没被写过一行 —— B5 才接上。
# 关掉它只用于「审计子系统本身在出问题，而生成得先跑起来」。

# ── 数据库 ──────────────────────────────────────────────────
# **不写这一项**就是默认的 SQLite（仓库根目录的 aivideo.db）。
# 要换 PostgreSQL 就把下面这行取消注释并填上：
# DATABASE_URL=postgresql+psycopg://user:pw@host:5432/aivideo
#
# 【为什么这里是注释掉的，而不是 `DATABASE_URL=` 留空】
# 因为空串和「没写」不是一回事 —— 留空会让配置拿到一个空值，
# 然后在建数据库连接时才炸，报的是一句和病因无关的错。
# 代码里也挡了一道（见 app/config.py 的 `_default_sqlite`），两处都有意为之。
